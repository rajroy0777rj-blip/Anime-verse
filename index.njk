<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090a0f">
  <meta name="description" content="{{ site.description }}">
  <meta property="og:title" content="{{ site.title }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ site.social_image or '' }}">
  <title>{{ site.title }} — {{ site.tagline }}</title>
  <style>
    :root {
      --bg:#090a0f; --surface:#11131c; --card:#171a25; --border:#292d3c;
      --violet:{{ site.accent_color or '#9b72ff' }}; --blue:{{ site.secondary_color or '#55a7ff' }}; --text:#f7f7fb; --muted:#a4a8b8;
      --max:1240px; --radius:18px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6}
    a{color:inherit;text-decoration:none}
    button,input{font:inherit}
    button{cursor:pointer}
    img{display:block;width:100%;object-fit:cover}
    .container{width:min(var(--max),calc(100% - 40px));margin-inline:auto}
    .announcement{padding:8px 16px;text-align:center;font-size:.82rem;background:linear-gradient(90deg,#29194b,#142b50);color:#e8e2ff}
    .announcement strong{color:#fff}
    .header{position:sticky;top:0;z-index:20;background:rgba(9,10,15,.88);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.08)}
    .nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:22px}
    .brand{font-size:1.35rem;font-weight:950;letter-spacing:.07em;white-space:nowrap;background:linear-gradient(100deg,var(--violet),var(--blue));-webkit-background-clip:text;background-clip:text;color:transparent}
    .navlinks{display:flex;align-items:center;gap:24px;color:var(--muted);font-size:.9rem}
    .navlinks a:hover,.navlinks a.active{color:#fff}
    .nav-actions{display:flex;align-items:center;gap:10px}
    .icon-btn,.menu-btn{border:1px solid var(--border);background:var(--surface);color:#fff;border-radius:11px;padding:10px 12px}
    .primary-btn{border:0;border-radius:11px;padding:11px 17px;color:#fff;font-weight:750;background:linear-gradient(110deg,#8b5cf6,#3b82f6);box-shadow:0 8px 25px #5b43ba25}
    .primary-btn:hover{filter:brightness(1.12);transform:translateY(-1px)}
    .menu-btn{display:none}
    .hero{padding:42px 0 30px}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;color:#cbb8ff;text-transform:uppercase;letter-spacing:.14em;font-size:.73rem;font-weight:800}
    .eyebrow:before{content:"";width:22px;height:2px;background:var(--violet)}
    .hero-grid{display:grid;grid-template-columns:1.65fr .85fr;gap:18px;margin-top:18px}
    .hero-main,.hero-side-card{position:relative;isolation:isolate;overflow:hidden;border:1px solid var(--border);border-radius:var(--radius);background:#171a25;min-height:300px}
    .hero-main{min-height:470px}
    .hero-main>img,.hero-side-card>img{position:absolute;inset:0;height:100%;z-index:-2;transition:transform .6s}
    .hero-main:hover>img,.hero-side-card:hover>img{transform:scale(1.04)}
    .hero-main:after,.hero-side-card:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,rgba(5,6,12,.96),rgba(5,6,12,.2) 72%,rgba(5,6,12,.05))}
    .hero-copy{position:absolute;left:clamp(20px,4vw,42px);right:30px;bottom:34px}
    .tag{display:inline-block;border:1px solid #a78bfa65;background:#8b5cf626;color:#d9caff;border-radius:7px;padding:5px 9px;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
    h1,h2,h3,p{margin-top:0}
    .hero h1{font-size:clamp(2rem,4.1vw,3.65rem);line-height:1.08;letter-spacing:-.045em;max-width:750px;margin:15px 0}
    .hero-copy p{max-width:630px;color:#d1d2de;margin-bottom:18px}
    .meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:.82rem}
    .meta .dot{width:4px;height:4px;background:var(--violet);border-radius:50%}
    .hero-side{display:grid;grid-template-rows:1fr 1fr;gap:18px}
    .hero-side-card{min-height:225px}
    .side-copy{position:absolute;left:20px;right:18px;bottom:18px}
    .side-copy h3{font-size:1.25rem;line-height:1.25;margin:10px 0}
    .section{padding:38px 0}
    .section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}
    .section-head h2{font-size:clamp(1.55rem,2.6vw,2.15rem);letter-spacing:-.035em;margin:5px 0 0}
    .section-head p{color:var(--muted);margin:4px 0 0;font-size:.92rem}
    .text-link{color:#c6b3ff;font-weight:700;font-size:.88rem}
    .text-link:hover{color:#fff}
    .filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
    .filter{background:var(--surface);border:1px solid var(--border);color:var(--muted);padding:8px 13px;border-radius:999px;font-size:.83rem}
    .filter.active,.filter:hover{background:#8b5cf626;color:#fff;border-color:#8b5cf6}
    .news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
    .news-card{overflow:hidden;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);transition:transform .2s,border-color .2s}
    .news-card:hover{transform:translateY(-4px);border-color:#6550a0}
    .news-image{height:205px;position:relative;overflow:hidden;background:#202333}
    .news-image img{height:100%;transition:transform .4s}
    .news-card:hover .news-image img{transform:scale(1.045)}
    .news-image .tag{position:absolute;left:13px;top:13px}
    .news-body{padding:17px}
    .news-body h3{font-size:1.12rem;line-height:1.35;margin:10px 0}
    .news-body p{font-size:.9rem;color:var(--muted);margin-bottom:15px}
    .trending-layout{display:grid;grid-template-columns:1.5fr .9fr;gap:24px}
    .trend-list{display:flex;flex-direction:column;gap:0}
    .trend-item{display:grid;grid-template-columns:42px 88px 1fr;align-items:center;gap:14px;padding:15px 0;border-bottom:1px solid var(--border)}
    .trend-num{font-size:1.35rem;font-weight:900;color:#5e6377}
    .trend-item img{height:68px;border-radius:10px}
    .trend-item h3{font-size:.97rem;line-height:1.35;margin:0 0 5px}
    .trend-item small{color:var(--muted)}
    .editorial-card{background:linear-gradient(145deg,#1b1830,#111b2b);border:1px solid #3d355f;border-radius:var(--radius);padding:26px;display:flex;flex-direction:column;justify-content:space-between;min-height:100%}
    .editorial-card h3{font-size:1.65rem;line-height:1.2;margin:18px 0 10px}
    .editorial-card p{color:#c0c3d2}
    .gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:160px;gap:13px}
    .gallery-item{position:relative;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--card);padding:0}
    .gallery-item:nth-child(1),.gallery-item:nth-child(5){grid-row:span 2}
    .gallery-item img{height:100%;transition:transform .45s}
    .gallery-item:hover img{transform:scale(1.06)}
    .gallery-item:after{content:"";position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.8))}
    .gallery-caption{position:absolute;z-index:1;left:13px;right:13px;bottom:12px;text-align:left;font-weight:750;font-size:.9rem}
    .newsletter{border:1px solid #3b3560;background:radial-gradient(ellipse at top right,#30224d 0,transparent 48%),#11131c;border-radius:22px;padding:clamp(24px,5vw,48px);display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}
    .newsletter h2{font-size:clamp(1.7rem,3vw,2.5rem);line-height:1.15;margin:10px 0}
    .newsletter p{color:var(--muted);margin:0}
    .signup{display:flex;gap:9px}
    .signup input,.search-input{min-width:0;width:100%;background:#090a0f;border:1px solid var(--border);border-radius:11px;padding:13px 14px;color:#fff;outline:none}
    .signup input:focus,.search-input:focus{border-color:var(--violet)}
    .form-note{font-size:.78rem;color:var(--muted);margin-top:9px}
    .footer{margin-top:45px;border-top:1px solid var(--border);background:#0b0c12;padding:42px 0 22px}
    .footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:30px}
    .footer p{color:var(--muted);max-width:340px;font-size:.9rem}
    .footer h4{margin:0 0 13px}
    .footer-links{display:grid;gap:9px;color:var(--muted);font-size:.88rem}
    .footer-links a:hover{color:#fff}
    .copyright{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:18px;margin-top:32px;color:#7e8396;font-size:.8rem}
    .search-panel{display:none;padding:0 0 16px}
    .search-panel.open{display:block}
    .search-row{display:flex;gap:10px}
    .empty-state{display:none;color:var(--muted);padding:24px;text-align:center;border:1px dashed var(--border);border-radius:14px}
    .toast{position:fixed;right:20px;bottom:20px;background:#202536;border:1px solid #454b60;padding:12px 17px;border-radius:12px;box-shadow:0 12px 40px #0008;z-index:40;display:none}
    .toast.show{display:block}
    .modal{display:none;position:fixed;inset:0;background:#000d;z-index:50;align-items:center;justify-content:center;padding:20px}
    .modal.open{display:flex}
    .modal-content{max-width:900px;width:100%;position:relative}
    .modal-content img{max-height:82vh;object-fit:contain;border-radius:12px}
    .modal-close{position:absolute;right:0;bottom:calc(100% + 8px);border:1px solid #555;background:#181a25;color:white;border-radius:9px;padding:8px 12px}
    @media(max-width:1000px){
      .navlinks{gap:14px}.hero-grid{grid-template-columns:1.3fr .8fr}.hero-main{min-height:420px}
      .news-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.footer-grid{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:760px){
      .container{width:min(100% - 28px,var(--max))}
      .nav{min-height:66px}.menu-btn{display:inline-flex}.navlinks{display:none;position:absolute;left:14px;right:14px;top:calc(100% + 7px);padding:17px;background:#11131c;border:1px solid var(--border);border-radius:14px;flex-direction:column;align-items:stretch;gap:0;box-shadow:0 20px 40px #0008}
      .navlinks.open{display:flex}.navlinks a{padding:11px 5px;border-bottom:1px solid #ffffff0c}
      .nav-actions .sign-in{display:none}.hero{padding-top:28px}.hero-grid{grid-template-columns:1fr}.hero-main{min-height:430px}.hero-side{grid-template-columns:1fr 1fr;grid-template-rows:none}.hero-side-card{min-height:220px}
      .trending-layout{grid-template-columns:1fr}.editorial-card{min-height:250px}.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:145px}
      .newsletter{grid-template-columns:1fr}.section{padding:28px 0}
    }
    @media(max-width:480px){
      .brand{font-size:1.13rem}.nav-actions{gap:6px}.icon-btn,.menu-btn{padding:9px}
      .hero-main{min-height:410px}.hero-side{grid-template-columns:1fr}.hero-side-card{min-height:220px}
      .news-grid{grid-template-columns:1fr}.news-image{height:220px}.section-head{align-items:start;flex-direction:column}
      .signup{flex-direction:column}.signup .primary-btn{width:100%}.footer-grid{grid-template-columns:1fr 1fr;gap:24px 16px}
      .trend-item{grid-template-columns:28px 75px 1fr;gap:10px}.trend-item img{height:62px}.trend-item h3{font-size:.88rem}
    }
  </style>
</head>
<body>
  <div class="announcement">✦ <strong>ANIMEVERSE WEEKLY</strong> — Your guide to the stories shaping anime. <a href="#latest">Explore the latest →</a></div>
  <header class="header">
    <div class="container nav">
      <a class="brand" href="/" aria-label="{{ site.title }} homepage">{{ site.title }}<span style="color:#fff">.</span></a>
      <nav class="navlinks" id="navlinks" aria-label="Main navigation">
        <a href="#" class="active">Home</a><a href="#latest">Anime News</a><a href="#seasonal">Seasonal Anime</a><a href="#manga">Manga</a><a href="#reviews">Reviews</a><a href="#gallery">Gallery</a>
      </nav>
      <div class="nav-actions">
        <button class="icon-btn" id="searchToggle" aria-label="Open search">⌕</button>
        <a href="#newsletter" class="primary-btn sign-in">Join the community</a>
        <button class="menu-btn" id="menuToggle" aria-label="Open menu" aria-expanded="false">☰</button>
      </div>
    </div>
    <div class="container search-panel" id="searchPanel">
      <div class="search-row"><input class="search-input" id="searchInput" type="search" placeholder="Search anime news, reviews, manga..." aria-label="Search posts"><button class="primary-btn" id="clearSearch">Clear</button></div>
    </div>
  </header>

  <main>
    <section class="hero container">
      <span class="eyebrow">The anime world, in focus</span>
      <div class="hero-grid">
        <a class="hero-main" href="#latest">
          <img src="https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1500&q=85" alt="Cinematic anime-inspired illustration" onerror="this.style.display='none'">
          <div class="hero-copy">
            <span class="tag">Featured Story</span>
            <h1>The next chapter of anime starts here.</h1>
            <p>Fresh perspectives, standout releases, and the stories fans will be talking about next.</p>
            <div class="meta"><span>ANIMEVERSE Editorial</span><span class="dot"></span><span>8 min read</span><span class="dot"></span><span>Featured</span></div>
          </div>
        </a>
        <div class="hero-side">
          <a class="hero-side-card" href="#seasonal">
            <img src="https://images.unsplash.com/photo-1601850494422-3cf14624b0b3?auto=format&fit=crop&w=800&q=80" alt="Colorful illustrated character artwork" onerror="this.style.display='none'">
            <div class="side-copy"><span class="tag">Season Preview</span><h3>What to keep on your watchlist this season</h3><div class="meta">5 min read · Features</div></div>
          </a>
          <a class="hero-side-card" href="#manga">
            <img src="https://images.unsplash.com/photo-1614583225154-5fcdda07019e?auto=format&fit=crop&w=800&q=80" alt="Manga and illustration inspired artwork" onerror="this.style.display='none'">
            <div class="side-copy"><span class="tag">Manga Watch</span><h3>From page to screen: adaptations to watch</h3><div class="meta">6 min read · Manga</div></div>
          </a>
        </div>
      </div>
    </section>

    <section class="section container" id="latest">
      <div class="section-head"><div><span class="eyebrow">Stay in the loop</span><h2>Latest Anime News</h2><p>Fresh updates and stories from across the anime universe.</p></div><a class="text-link" href="#latest">Explore all stories ↗</a></div>
      <div class="filters" role="group" aria-label="Filter news category">
        <button class="filter active" data-filter="all">All stories</button><button class="filter" data-filter="news">Anime News</button><button class="filter" data-filter="seasonal">Seasonal</button><button class="filter" data-filter="manga">Manga</button><button class="filter" data-filter="reviews">Reviews</button>
      </div>
      <div class="news-grid" id="newsGrid">
        {% for post in collections.posts | reverse %}
        <article class="news-card" data-category="{{ (post.data.category or 'news') | lower | replace(' ', '-') }}" data-search="{{ (post.data.title ~ ' ' ~ (post.data.description or '') ~ ' ' ~ ((post.data.tags or []) | join(' '))) | lower }}">
          <a href="{{ post.data.external_url or post.url }}" {% if post.data.external_url %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <div class="news-image"><img src="{{ post.data.featured_image or 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=800&q=80' }}" alt="{{ post.data.title }}" loading="lazy"><span class="tag">{{ post.data.category or 'Anime News' }}</span></div>
          </a>
          <div class="news-body"><div class="meta">{{ post.data.category or 'NEWS' }} <span class="dot"></span> {{ post.data.read_time or '5 min read' }}</div><h3><a href="{{ post.data.external_url or post.url }}" {% if post.data.external_url %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ post.data.title }}</a></h3><p>{{ post.data.description or '' }}</p><div class="meta">By {{ post.data.author or site.title }}</div></div>
        </article>
        {% else %}
        <p>No published stories yet. Sign in to /admin/ to add your first post.</p>
        {% endfor %}
      </div>
      <div class="empty-state" id="emptyState">No stories match your search. Try another keyword or category.</div>
    </section>

    <section class="section container" id="seasonal">
      <div class="trending-layout">
        <div><div class="section-head"><div><span class="eyebrow">In the conversation</span><h2>Trending Stories</h2><p>Topics worth a place on your radar.</p></div></div>
          <div class="trend-list">
            <a href="#latest" class="trend-item"><span class="trend-num">01</span><img src="https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=240&q=75" alt="" loading="lazy"><div><h3>Visual storytelling that stays with you</h3><small>Features · 6 min read</small></div></a>
            <a href="#manga" class="trend-item"><span class="trend-num">02</span><img src="https://images.unsplash.com/photo-1614583225154-5fcdda07019e?auto=format&fit=crop&w=240&q=75" alt="" loading="lazy"><div><h3>The manga stories readers recommend most</h3><small>Manga · 5 min read</small></div></a>
            <a href="#reviews" class="trend-item"><span class="trend-num">03</span><img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=240&q=75" alt="" loading="lazy"><div><h3>Atmosphere, music, and unforgettable scenes</h3><small>Reviews · 7 min read</small></div></a>
            <a href="#gallery" class="trend-item"><span class="trend-num">04</span><img src="https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=240&q=75" alt="" loading="lazy"><div><h3>Fan gallery: worlds beyond the ordinary</h3><small>Gallery · 3 min read</small></div></a>
          </div>
        </div>
        <aside class="editorial-card" id="manga"><div><span class="tag">The ANIMEVERSE edit</span><h3>Stories deserve a place beyond the scroll.</h3><p>Thoughtful coverage, curated imagery, and a growing universe of anime culture — all in one place.</p></div><a href="#newsletter" class="primary-btn" style="align-self:flex-start">Get the weekly edit →</a></aside>
      </div>
    </section>

    <section class="section container" id="gallery">
      <div class="section-head"><div><span class="eyebrow">A visual universe</span><h2>Anime Photo Gallery</h2><p>Explore colors, moods, and worlds through a curated visual feed.</p></div><a class="text-link" href="#gallery">View gallery ↗</a></div>
      <div class="gallery-grid">
        <button class="gallery-item" data-full="https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=1600&q=90" aria-label="View featured artwork"><img src="https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80" alt="Colorful illustration-inspired art" loading="lazy"><span class="gallery-caption">Dreamlike Worlds</span></button>
        <button class="gallery-item" data-full="https://images.unsplash.com/photo-1601850494422-3cf14624b0b3?auto=format&fit=crop&w=1600&q=90" aria-label="View character artwork"><img src="https://images.unsplash.com/photo-1601850494422-3cf14624b0b3?auto=format&fit=crop&w=600&q=80" alt="Vibrant fantasy artwork" loading="lazy"><span class="gallery-caption">Color & Character</span></button>
        <button class="gallery-item" data-full="https://images.unsplash.com/photo-1614583225154-5fcdda07019e?auto=format&fit=crop&w=1600&q=90" aria-label="View graphic artwork"><img src="https://images.unsplash.com/photo-1614583225154-5fcdda07019e?auto=format&fit=crop&w=600&q=80" alt="Graphic illustration" loading="lazy"><span class="gallery-caption">Graphic Stories</span></button>
        <button class="gallery-item" data-full="https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=1600&q=90" aria-label="View night sky image"><img src="https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=600&q=80" alt="Stars across a night sky" loading="lazy"><span class="gallery-caption">Midnight Dreams</span></button>
        <button class="gallery-item" data-full="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1600&q=90" aria-label="View atmospheric scenery"><img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=600&q=80" alt="Atmospheric scenery" loading="lazy"><span class="gallery-caption">Quiet Moments</span></button>
        <button class="gallery-item" data-full="https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=1600&q=90" aria-label="View cinematic image"><img src="https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=600&q=80" alt="Cinematic film atmosphere" loading="lazy"><span class="gallery-caption">Cinema & Craft</span></button>
      </div>
      <p class="form-note">Demo gallery imagery is illustrative and is not represented as official anime artwork. Verify each asset's license and attribution before publishing.</p>
    </section>

    <section class="section container" id="reviews">
      <div class="newsletter" id="newsletter">
        <div><span class="eyebrow">Join the community</span><h2>Your weekly anime fix, delivered.</h2><p>Get a curated mix of headlines, reviews, and visual inspiration in your inbox.</p></div>
        <div><form class="signup" id="newsletterForm"><input type="email" id="emailInput" placeholder="you@example.com" aria-label="Your email address" required><button class="primary-btn" type="submit">Subscribe ↗</button></form><div class="form-note" id="formNote">By subscribing, you agree to receive updates. Demo form only; no email is sent or stored.</div></div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div><a class="brand" href="/">{{ site.title }}.</a><p>{{ site.description }}</p></div>
        <div><h4>Explore</h4><div class="footer-links"><a href="#latest">Anime News</a><a href="#seasonal">Seasonal Anime</a><a href="#manga">Manga</a><a href="#reviews">Reviews</a></div></div>
        <div><h4>Discover</h4><div class="footer-links"><a href="#gallery">Photo Gallery</a><a href="#gallery">Wallpapers</a><a href="#latest">Features</a><a href="#newsletter">Newsletter</a></div></div>
        <div><h4>ANIMEVERSE</h4><div class="footer-links"><a href="#about">About us</a><a href="mailto:hello@example.com">Contact</a><a href="#privacy">Privacy</a><a href="#terms">Terms</a></div></div>
      </div>
      <div class="copyright"><span>© <span id="year"></span> ANIMEVERSE. All rights reserved.</span><span>Made for the love of anime culture.</span></div>
    </div>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <div class="modal" id="imageModal" role="dialog" aria-modal="true" aria-label="Gallery image viewer"><div class="modal-content"><button class="modal-close" id="modalClose">Close ✕</button><img id="modalImage" src="" alt="Expanded gallery artwork"></div></div>

  <script>
    const navlinks = document.getElementById('navlinks');
    const menuToggle = document.getElementById('menuToggle');
    const searchToggle = document.getElementById('searchToggle');
    const searchPanel = document.getElementById('searchPanel');
    const searchInput = document.getElementById('searchInput');
    const clearSearch = document.getElementById('clearSearch');
    const cards = [...document.querySelectorAll('.news-card')];
    const filters = [...document.querySelectorAll('.filter')];
    const emptyState = document.getElementById('emptyState');
    let activeCategory = 'all';

    menuToggle.addEventListener('click', () => {
      const open = navlinks.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.textContent = open ? '✕' : '☰';
    });
    navlinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      navlinks.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.textContent = '☰';
    }));
    searchToggle.addEventListener('click', () => {
      searchPanel.classList.toggle('open');
      if (searchPanel.classList.contains('open')) searchInput.focus();
    });
    function filterCards() {
      const query = searchInput.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach(card => {
        const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
        const text = (card.innerText + ' ' + (card.dataset.search || '')).toLowerCase();
        const searchMatch = !query || text.includes(query);
        card.style.display = categoryMatch && searchMatch ? '' : 'none';
        if (categoryMatch && searchMatch) shown++;
      });
      emptyState.style.display = shown ? 'none' : 'block';
    }
    filters.forEach(button => button.addEventListener('click', () => {
      filters.forEach(b => b.classList.toggle('active', b === button));
      activeCategory = button.dataset.filter;
      filterCards();
    }));
    searchInput.addEventListener('input', filterCards);
    clearSearch.addEventListener('click', () => { searchInput.value = ''; activeCategory = 'all'; filters.forEach(b => b.classList.toggle('active', b.dataset.filter === 'all')); filterCards(); searchInput.focus(); });
    const toast = document.getElementById('toast');
    function showToast(message) {
      toast.textContent = message;
      toast.classList.add('show');
      window.setTimeout(() => toast.classList.remove('show'), 3500);
    }
    document.getElementById('newsletterForm').addEventListener('submit', event => {
      event.preventDefault();
      const email = document.getElementById('emailInput');
      if (!email.checkValidity()) { email.reportValidity(); return; }
      showToast('Thanks! This demo form is not connected to a mailing service yet.');
      document.getElementById('formNote').textContent = 'Demo only: connect a newsletter provider to collect subscriptions.';
      email.value = '';
    });
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    document.querySelectorAll('.gallery-item').forEach(item => item.addEventListener('click', () => {
      modalImage.src = item.dataset.full;
      modalImage.alt = item.querySelector('img').alt;
      modal.classList.add('open');
      document.getElementById('modalClose').focus();
    }));
    function closeModal() { modal.classList.remove('open'); modalImage.src = ''; }
    document.getElementById('modalClose').addEventListener('click', closeModal);
    modal.addEventListener('click', event => { if (event.target === modal) closeModal(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') closeModal(); });
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
